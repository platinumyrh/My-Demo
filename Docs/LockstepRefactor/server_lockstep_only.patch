-                        {
-                            // 超出合理速度：钳制到边界（挡瞬移，同时保留正常移动）
-                            float scale = maxDist / dist;
-                            x = last.X + dx * scale;
-                            y = last.Y + dy * scale;
-                            z = last.Z + dz * scale;
-
-                            int count = Interlocked.Increment(ref _clampCount);
